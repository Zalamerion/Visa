# ── Required ──────────────────────────────────────────────────────────────────
EMAIL=your_email@gmail.com
PASSWORD=your_password
COUNTRY_CODE=uz
SCHEDULE_ID=your_schedule_id
FACILITY_ID=136
CURRENT_DATE=2026-08-12        # Your existing appointment date (YYYY-MM-DD)

# ── Telegram Notifications (recommended) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Optional ──────────────────────────────────────────────────────────────────
REFRESH_DELAY=30               # Seconds between checks (default: 5)
BOOK_MODE=false                # Set to "true" to auto-book found slots