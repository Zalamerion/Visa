# ── Required ──────────────────────────────────────────────────────────────────
EMAIL=your_email@gmail.com
PASSWORD=your_password
COUNTRY_CODE=uz
SCHEDULE_ID=your_schedule_id
FACILITY_ID=136
CURRENT_DATE=2026-08-12        # Your current appointment date — bot looks for anything earlier than this

# ── Telegram Notifications (recommended) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Optional ──────────────────────────────────────────────────────────────────
REFRESH_DELAY=30               # Seconds between checks (default: 5)
BOOK_MODE=false                # Set to "true" to auto-book found slots
DAILY_REPORT_HOUR=23           # Hour (Tashkent time, 0-23) to send the daily summary (default: 23 = 11 PM)